# 正式環境的 backend/.env 範本（DigitalOcean Droplet + DO Managed Postgres）。
#
# 用法：在 Droplet 上 `cp backend/.env.production.example backend/.env` 後填值。
# ⚠️ 這個檔案 MUST NOT 進版控，也 MUST NOT 出現在映像裡（.dockerignore 已排除）。
# 憑證只存在於這一個檔案（憲章後端約束、FR-085、SC-022）。
#
# 與開發用的 .env.example 差異只在值，欄位是同一組——刻意如此，
# 「正式環境有一個開發環境沒有的旗標」會讓兩邊的行為無法互相驗證。

# ---------------------------------------------------------------------------
# 資料庫：DigitalOcean Managed Postgres
# ---------------------------------------------------------------------------
# 值取自 DO 控制台 → Databases → 你的叢集 → Connection details，
# 使用者選 `doadmin`，Connection parameters 那一欄逐項對照填入。
#
# ⚠️ **不要用 Connection string 那一欄整條貼過來。** 本專案刻意把連線資訊拆成
# 元件（見 config.py）：密碼裡的 @ / : # 在 URL 裡會改變語意，而拼錯的症狀是
# DNS 失敗，看起來跟密碼毫無關係。這裡填的密碼是原樣，不需要 URL 編碼。

DB_HOST=<你的叢集>.b.db.ondigitalocean.com
# ⚠️ DO 的 Postgres 不是 5432。照 Connection details 顯示的填（通常是 25060）。
DB_PORT=25060
# ⚠️ DO 預設的資料庫叫 defaultdb，不是 postgres。
DB_NAME=defaultdb

# 兩個角色指向同一台資料庫，MUST NOT 是同一個角色。
#
# `admin_logs` 的「僅可新增」由 REVOKE UPDATE, DELETE 保證，而 REVOKE
# **只對非擁有者生效**——擁有者保有隱含權限。應用若以 doadmin 連線，
# 那道 REVOKE 是一句不報錯也不生效的 SQL，稽核日誌就悄悄變得可以竄改
# （憲章資料庫約束、SC-027）。
#
# 遷移用 doadmin 跑（要建擴充、函式與 sunny_app 角色本身），應用用 sunny_app 跑。

# 擁有者：DO 建立叢集時給的管理帳號
DB_OWNER_USER=doadmin
DB_OWNER_PASSWORD=

# 應用角色：非擁有者，由 alembic 的 0001_initial 依這個密碼建立。
# 自己產一組：python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠️ 這個值 MUST 在跑 `alembic upgrade head` 之前就填好——角色的密碼是由
# 那支 revision 從這裡讀出來設定的。事後才改這一行，應用會拿新密碼去登入一個
# 還是舊密碼的角色，錯誤是 password authentication failed。
# 真要改，重跑一次 `alembic upgrade head` 以外還得手動 alter role。
DB_APP_USER=sunny_app
DB_APP_PASSWORD=

# ⚠️ DigitalOcean Managed Postgres 只接受加密連線，這一行 MUST 有值。
#
# 留空時 asyncpg 走 prefer：嘗試加密、失敗則**靜默退回明文**。連線會成功、
# 查詢會正常、沒有任何警告，只是密碼雜湊與訂單資料在網路上是明文傳輸的。
#
# 想要更嚴格（連憑證也驗）就改成 verify-full，但那需要把 DO 提供的 CA 憑證
# 掛進容器並讓 asyncpg 讀得到；require 已足以確保連線加密。
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# 認證
# ---------------------------------------------------------------------------
# ⚠️ MUST 與開發環境用不同的值，且 MUST NOT 從任何地方複製貼上。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# 換掉這個值會讓所有已簽發的 JWT 立即失效，也就是全站使用者被登出。
# 這是正確的行為，但別在有人正在用的時候做。
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# Google 第三方登入（選填；留空則該功能不可用，但應用仍可正常啟動）
# ---------------------------------------------------------------------------
# ⚠️ 回呼網址 MUST 與 Google Cloud Console 的「已授權的重新導向 URI」逐字相同，
# 包含 scheme、有無結尾斜線。差一個字元的錯誤是 redirect_uri_mismatch，
# 那個訊息不會告訴你差在哪裡。
#
# ⚠️ Google 不接受 http://（localhost 除外），因此這裡 MUST 是後端的 HTTPS 位址。
# 另外 Google 對 pages.dev 這類公共後綴網域的授權有額外限制，
# 若前端還在 *.pages.dev 上，建議等有自己的網域再開啟這項功能。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.203-0-113-5.sslip.io/auth/google/callback

# ---------------------------------------------------------------------------
# 前端站台
# ---------------------------------------------------------------------------
# Google 回呼結束後把瀏覽器送回這裡。填 Cloudflare Pages 的正式網址。
# ⚠️ 結尾不要加斜線。
FRONTEND_BASE_URL=https://sunny-hotel.pages.dev

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# ⚠️ MUST 逐一列出來源，MUST NOT 用 *（憲章後端約束——* 搭配 allow_credentials
# 會讓任何網站都能帶著使用者的憑證呼叫本 API）。多個以逗號分隔、不要有空格。
#
# ⚠️ 這裡填的是**前端的網址**，不是後端自己的。填錯的症狀是瀏覽器主控台出現
# CORS 錯誤而後端日誌顯示 200——請求真的到了，只是回應被瀏覽器丟掉。
#
# Cloudflare Pages 每個分支與每次部署都會有自己的預覽網址
# （<hash>.<專案>.pages.dev），那些網址**不在**這份清單裡，所以預覽站的 API
# 呼叫會被擋。若需要預覽環境，另外開一組後端或把預覽網址一併列進來。
CORS_ORIGINS=https://sunny-hotel.pages.dev

# ---------------------------------------------------------------------------
# 示範帳號（選填，但公開站台請讀完這一段再決定）
# ---------------------------------------------------------------------------
# 會員帳號 guest@sunny.com / guest123 公開是**設計的一部分**（FR-005）：
# 訪客要能直接走一遍訂房流程。這裡不提供覆寫，也不需要。
#
# ⚠️ 管理員不一樣。`admin@sunny.com` / `admin123` 寫在版控裡、印在登入頁上、
# 也寫在 README 裡。站台放上公網後，任何讀過的人都能進入十二個後台模組
# ——改房價、讀客服訊息、看用戶清單、匯出報表。
# 而本專案**沒有任何修改密碼的端點**，所以「上線後自己去改」這條路不存在。
#
# 兩個選擇，沒有第三個：
#
#   (a) 後台就是要公開給人看 → 這兩行留空，並且不要設前端的
#       VITE_HIDE_ADMIN_DEMO。這是刻意的展示決定，不是疏忽。
#
#   (b) 後台不公開 → 這兩行填值，**並且**在 Cloudflare Pages 設定
#       VITE_HIDE_ADMIN_DEMO=true。只做一邊的結果是登入頁印著一組
#       已經失效的密碼，看起來像網站壞了。
#
# ⚠️ 填值後 MUST 重跑一次 seed 密碼才會生效：
#     docker compose run --rm api python -m sunny.seed
#   ⚠️ 該指令會把業務資料還原成初始展示狀態（訂單、評論等一併重置）。
#
# 產生密碼：python -c "import secrets; print(secrets.token_urlsafe(24))"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 檔案上傳
# ---------------------------------------------------------------------------
# ⚠️ 正式環境**不要**在這裡設 UPLOAD_DIR。
#
# Dockerfile 已經把它設成 /app/uploads，而 docker-compose.yml 正是把持久化的
# volume 掛在那個路徑。在這裡覆寫成別的路徑，檔案會寫進容器的暫時層——
# 上傳成功、照片顯示正常，直到下一次 `docker compose up --build`，
# 然後全部消失，而且沒有任何錯誤訊息。
# UPLOAD_DIR=

MAX_UPLOAD_BYTES=2097152

# ---------------------------------------------------------------------------
# 測試
# ---------------------------------------------------------------------------
# ⚠️ 正式環境留空。這個變數指向的資料庫會被測試寫入與刪除。
SUNNY_TEST_DATABASE_URL=
