# Sunny 訂房平台 — 後端環境變數範本
#
# 用法：複製為 backend/.env 並填入實際值。
#
# 憲章後端約束：缺少必要變數時，應用 MUST 於啟動時明確失敗，MUST NOT 以預設值靜默啟動。
# `.env` MUST NOT 進版控；本檔（.env.example）MUST 進版控且 MUST 列出所有必要變數。

# ---------------------------------------------------------------------------
# 資料庫（兩組連線字串，指向同一台資料庫但使用不同角色）
# ---------------------------------------------------------------------------
# 這個分離是 T021a 的要求，不是多餘的設定。
#
# `admin_logs` 的「僅可新增」由 `REVOKE UPDATE, DELETE` 保證，而 REVOKE 只對
# 非擁有者生效——資料表擁有者保有隱含權限。若應用以擁有者身分連線，那道 REVOKE
# 是一句不會報錯、也不會生效的 SQL，日誌就這樣悄悄變得可以竄改（憲章資料庫約束、SC-027）。
#
# 因此：遷移用擁有者跑，應用用 sunny_app 跑。兩者 MUST NOT 是同一個角色。

# 應用連線：MUST 為非擁有者的 sunny_app 角色
DATABASE_URL=postgresql+asyncpg://sunny_app:CHANGE_ME@localhost:5432/sunny

# 遷移連線：擁有者角色，供 alembic 建立資料表、函式、擴充與角色本身
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/sunny

# sunny_app 角色的密碼，供初始 revision 建立該角色時使用（T021a）
APP_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# 認證
# ---------------------------------------------------------------------------
# JWT_SECRET 沒有預設值 fallback——「沒設就用預設值」等同於公開秘鑰（憲章原則 VI）。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# Google 第三方登入（FR-087、research R7）
# ---------------------------------------------------------------------------
# client secret MUST 只存在於後端環境變數，MUST NOT 出現在前端任何位置。
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# CORS（憲章後端約束）
# ---------------------------------------------------------------------------
# 允許來源 MUST 明確列出。MUST NOT 使用 ["*"] 搭配 allow_credentials=True。
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 檔案上傳
# ---------------------------------------------------------------------------
# 僅管理員路徑會寫入此處。前台「安全檢測」沒有對應端點（FR-086、SC-030）。
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152
