# Sunny 訂房平台 — 後端環境變數範本
#
# 用法：複製為 backend/.env 並填入實際值。
#
# 憲章後端約束：缺少必要變數時，應用 MUST 於啟動時明確失敗，MUST NOT 以預設值靜默啟動。
# `.env` MUST NOT 進版控；本檔（.env.example）MUST 進版控且 MUST 列出所有必要變數。
#
# 標示 ⚠️ 的沒有預設值，未填會讓應用在啟動時失敗。其餘可留空使用預設值。

# ---------------------------------------------------------------------------
# 資料庫（元件式，不是一整條連線字串）
# ---------------------------------------------------------------------------
# 為什麼拆成元件而不是給一條 URL：密碼裡的 @ / : # 與空白會在 URL 裡改變語意。
# `postgresql://user:p@ss@host/db` 的第一個 @ 會被當成「密碼結束」，主機於是
# 變成 `ss@host`——**這不會報錯**，只會連到一個不存在的主機，而錯誤訊息是 DNS
# 失敗，看起來跟密碼毫無關係。拆開後由程式統一 quote_plus 編碼，填的人不需要
# 知道哪些字元要編碼，也就不會編錯。見 src/sunny/config.py。

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# 兩個角色指向同一台資料庫，MUST NOT 是同一個角色。
#
# 這個分離是 T021a 的要求，不是多餘的設定：`admin_logs` 的「僅可新增」由
# `REVOKE UPDATE, DELETE` 保證，而 REVOKE **只對非擁有者生效**——資料表擁有者
# 保有隱含權限。應用若以擁有者連線，那道 REVOKE 是一句不報錯也不生效的 SQL，
# 稽核日誌就這樣悄悄變得可以竄改（憲章資料庫約束、SC-027）。
#
# 遷移用擁有者跑（要建表、函式、擴充與角色本身），應用用 sunny_app 跑。

# 擁有者角色：供 alembic 使用
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=

# 應用角色：非擁有者，由初始 revision 建立
DB_APP_USER=sunny_app
DB_APP_PASSWORD=

# ---------------------------------------------------------------------------
# 認證
# ---------------------------------------------------------------------------
# ⚠️ JWT_SECRET 沒有預設值 fallback——「沒設就用預設值」等同於公開秘鑰
# （憲章原則 VI）。至少 32 字元，且 CHANGE_ME 這類佔位值會被明確拒絕：
# 佔位值能讓應用順利啟動，於是沒有人會發現秘鑰其實是公開的。
#
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# Google 第三方登入（US2 才需要；留空則該功能不可用，但應用仍可啟動）
# ---------------------------------------------------------------------------
# client secret MUST 只存在於後端環境變數，MUST NOT 出現在前端任何位置。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# 前端站台
# ---------------------------------------------------------------------------
# Google 回呼結束後把瀏覽器送回這裡。OAuth 回呼是**瀏覽器的導覽**而不是前端
# 發出的 fetch，因此那條路徑不能像其他端點一樣回 JSON——使用者會看到一頁
# {"accessToken": ...}。後端必須知道要把他送回哪裡。
FRONTEND_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# CORS（憲章後端約束）
# ---------------------------------------------------------------------------
# 允許來源 MUST 明確列出。MUST NOT 使用 ["*"] 搭配 allow_credentials=True。
# 多個來源以逗號分隔。
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 檔案上傳
# ---------------------------------------------------------------------------
# 僅管理員路徑會寫入此處。前台「安全檢測」沒有對應端點（FR-086、SC-030）。
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152

# ---------------------------------------------------------------------------
# 測試（選填）
# ---------------------------------------------------------------------------
# 需要資料庫的測試會讀這個值；**未設定時那些測試會跳過**，而不是連上應用的
# 資料庫就地清空開發資料（tests/conftest.py）。
#
# ⚠️ 多台機器同時開發時，每台 MUST 指向**不同的**資料庫——測試會執行
# `truncate ... cascade`，共用一個庫會互相清掉對方的資料。
SUNNY_TEST_DATABASE_URL=
